# Copy to .env for local development. Every value below is a documented default.
# In production these are set via `fly secrets set` / fly.toml [env] (§12.2).

# local | production. Production hides /docs and /openapi.json.
ENVIRONMENT=local

# SQLite path. Local uses a relative file; production uses the Fly volume.
# NOTE the four slashes in the prod form: sqlite:/// + absolute path /data/zoom.db
DATABASE_URL=sqlite:///./zoom.db
# DATABASE_URL=sqlite:////data/zoom.db

# Comma-separated list of allowed browser origins. The frontend calls this API
# directly (§1.2), so this must include the deployed Workers URL in production.
CORS_ORIGINS=http://localhost:3000

# Google OAuth client ID — used to validate the `aud` claim on incoming ID
# tokens (§8). Must match AUTH_GOOGLE_ID on the frontend. Required from P12.
GOOGLE_CLIENT_ID=

# Signing key for app-issued JWTs. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be overridden in production.
SECRET_KEY=dev-insecure-change-me

# Optional (§9). Empty => in-process MemoryCache. Setting it selects RedisCache,
# which is phase 2 and currently raises NotImplementedError — leave unset.
REDIS_URL=

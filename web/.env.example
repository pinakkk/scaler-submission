# ---------------------------------------------------------------------------
# Zoom Clone — web environment
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time — never
# put a secret behind that prefix. In production these are set as Cloudflare
# Worker secrets (`wrangler secret put`), never in wrangler.toml (BLUEPRINT §12.1).
# ---------------------------------------------------------------------------

# FastAPI backend base URL (no trailing slash). The browser calls this directly;
# requests are NOT proxied through the Worker (BLUEPRINT §1.2).
# Local: http://localhost:8000   Production: https://<your-api>.fly.dev
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# WebSocket base for signaling at /ws/meeting/{meeting_number} (BLUEPRINT §5.2).
# Local: ws://localhost:8000     Production: wss://<your-api>.fly.dev
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# --- Auth.js v5 / Google OAuth (BLUEPRINT §8, §12.4) -----------------------
# From Google Cloud Console -> OAuth 2.0 Client (Web).
# Authorized redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Secret used to sign/encrypt the session JWT. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical origin of this app. Must match the OAuth redirect URI's origin.
# Local: http://localhost:3000   Production: https://<your-worker>.workers.dev
NEXTAUTH_URL=http://localhost:3000

# `dev` keeps local setup usable without Google credentials by calling the
# API's production-disabled /auth/dev endpoint. Deployments must use `google`.
NEXT_PUBLIC_AUTH_MODE=dev
